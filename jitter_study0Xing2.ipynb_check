   "source": [
    "#fig, ax = plt.subplots(figsize=(8,4),nrows=1,ncols=2)\n",
    "F, (ax1, ax2) = plt.subplots(figsize=(8,4),nrows=1,ncols=2)\n",
    "\n",
    "# I want to average the fphase_avg signal for a given value of fine_ph but the number of point in each bin is not the same\n",
    "ax1.set_xlabel('time (ps)')\n",
    "ax1.set_ylabel('Counts')\n",
    "print ('total', len(AmplJitter))\n",
    "ax1.hist(np.polyval(coeffsInverse, AmplJitter)-mu, bins=np.linspace(-4, 4, 50), label='stat_peak', color='C2', alpha=0.5, density=True)    \n",
    "#ax2.plot(x_fit-mu, y_fit, 'C3--', label='Gaussian fit')\n",
    "#print standard deviation on plot np.std(np.polyval(coeffsInverse, AmplJitter))\n",
    "print ('sd', np.std(np.polyval(coeffsInverse, AmplJitter)))\n",
    "ax1.set_xlim(-4, 4)\n",
    "print (mu, sigma)\n",
    "\n",
    "noise = np.array([0.5, 0.75, 1, 1.5])\n",
    "for i in range(len(noise)):\n",
    "    rphase=np.random.standard_normal(1000)*noise[i]+mu\n",
    "    ax2.hist(np.polyval(coeffsInverse, fpeak1_avg_func(rphase))-mu, bins=np.linspace(-4, 4, 50), label='jitter='+str(noise[i])+'ps', alpha=0.5, density=True)\n",
    "ax2.set_xlabel('time (ps)')\n",
    "ax2.set_ylabel('Counts')    \n",
    "ax1.text(0.95, 0.905,'(a)', ha='center', va='center', transform=ax1.transAxes)\n",
    "ax2.text(0.95, 0.905,'(b)', ha='center', va='center', transform=ax2.transAxes)\n",
    "ax1.set_xlim(-4, 4)\n",
    "ax2.set_xlim(-4, 4)\n",
    "ax2.legend()\n",
    "ax2.grid()\n",
    "ax1.grid()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('jitterSimu.png', dpi=300, bbox_inches='tight', transparent  ='true')"
   ]
