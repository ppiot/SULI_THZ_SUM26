   "source": [
    "ind=0\n",
    "for i in range(0, len(fpeak1)): \n",
    "    if i==0:\n",
    "        ind=1\n",
    "        first=True\n",
    "        fpeak1_tmp= fpeak1[i]\n",
    "        fpeak2_tmp= fpeak2[i]\n",
    "    if i>0 and fine_ph[i] == fine_ph[i-1]:\n",
    "        fpeak1_tmp+= fpeak1[i]\n",
    "        fpeak2_tmp+= fpeak2[i]\n",
    "        ind+=1\n",
    "    \n",
    "    if i>0 and fine_ph[i] != fine_ph[i-1]:\n",
    "        print (i, ind, fpeak1_tmp/ind, fpeak2_tmp/ind, phase_tmp)\n",
    "        if first:\n",
    "            fpeak1_avg = fpeak1_tmp/ind\n",
    "            fpeak2_avg = fpeak2_tmp/ind\n",
    "            phase_avg  = fine_ph[i-1]\n",
    "            first=False\n",
    "        else:\n",
    "            fpeak1_avg=np.append(fpeak1_avg, fpeak1_tmp/(ind))\n",
    "            fpeak2_avg=np.append(fpeak2_avg, fpeak2_tmp/(ind))\n",
    "            phase_avg=np.append(phase_avg, fine_ph[i-1])\n",
    "        fpeak1_tmp= 0\n",
    "        fpeak2_tmp= 0\n",
    "        ind=0\n",
    "\n",
    "plt.plot(fine_ph,fpeak1,'C7', alpha=0.76, label='fpeak1')\n",
    "plt.plot(phase_avg, fpeak1_avg, label='fpeak1_avg')\n",
    "\n",
    "#"
   ]
  },
