   "source": [
    "# do a cubic spline interpolation of fine_ph[::4],fpeak1_avg and fine_ph[::4],fpeak2_avg\n",
    "from scipy.interpolate import interp1d\n",
    " # create an interpolated function for fpeak1_avg\n",
    "fpeak1_avg_func = interp1d(phase_avg, fpeak1_avg, kind='linear', fill_value=\"extrapolate\")\n",
    "# create an interpolated function for fpeak2_avg\n",
    "fpeak2_avg_func = interp1d(phase_avg, fpeak2_avg, kind='linear', fill_value=\"extrapolate\")\n",
    "# create an interpolated function for phase_avg\n",
    "\n",
    "# plot the spline interpolation\n",
    "f, ax = plt.subplots(1,1, figsize=(5,4))    \n",
    "ax.plot(fine_ph, fpeak1_avg_func(fine_ph), 'C0', label='fpeak1 spline')\n",
    "ax.plot(fine_ph, fpeak2_avg_func(fine_ph), 'C1', label='fpeak2 spline')\n",
    "ax.set_xlabel('time (ps)')\n",
    "ax.set_ylabel('Amplitude (V)')\n",
    "ax.grid()\n",
    "ax.legend()\n",
    "plt.tight_layout()\n"
   ]
  },
