   "source": [
    "dirname='./July31_/'\n",
    "fname= 'CoarseScan10nC_4_0.npz'\n",
    "data1= np.load(dirname+fname)\n",
    "data1   \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "id": "41b44367",
   "metadata": {},
   "outputs": [],
   "source": [
    "# this is the phase in degreea\n",
    "phase= data1['phase']\n",
    "# this is the associated time delay in ps\n",
    "phase_time_delay = phase / 81.25e6 / 360 * 1e12"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "id": "d93dacb9",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 300x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#plot one set of data in data['AWAVXI11:Tek1:wf2']      \n",
    "f, (ax1, ax2) = plt.subplots(2,1, figsize=(3,4))\n",
    "\n",
    "ax1.plot(data['AWAVXI11:Tek1:x'][0][:]*1e9, 1e3*data['AWAVXI11:Tek1:wf1'][0][:], 'C8', label='BPM')\n",
    "ax1.plot(data['AWAVXI11:Tek1:x'][0][:]*1e9, 1e4*(data['AWAVXI11:Tek1:wf3'][0][:]-0.051), 'C6', label='PD')\n",
    "ax1.plot(data['AWAVXI11:Tek1:x'][0][:]*1e9, 500+1e4*data['AWAVXI11:Tek1:wf2'][0][:], 'C7', label='SD'   )\n",
    "ax1.legend(loc='lower right')\n",
    "ax1.set_xlabel('time (ns)')\n",
    "ax1.set_ylabel('signal (arb. units)')\n",
    "ax1.grid()\n",
    "# remove vertical space between subplots\n",
    "# add a line at y=0\n",
    "ax2.set_xlabel('time (ns)')\n",
    "ax2.set_ylabel('signal (mV)')\n",
    "for i in range(0, data1['BPDwf'].shape[0]):\n",
    "    ax2.plot(1e9*data1['x'][0,:], 1e3*data1['BPDwf'][i,2,:], label='BPDwf', alpha=0.5, color='C0')\n",
    "ax2.grid()\n",
    "\n",
    "ax1.text(0.95, 0.905,'(a)', ha='center', va='center', transform=ax1.transAxes)\n",
    "ax2.text(0.95, 0.905,'(b)', ha='center', va='center', transform=ax2.transAxes)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('timingandscan.png', dpi=300, bbox_inches='tight', transparent  ='true')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 65,
   "id": "2ff9cb9f",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 300x400 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#combine the plot from ax2 above and the image plot into one figure\n",
    "f, (ax1, ax2) = plt.subplots(2,1, figsize=(3,4), sharex=True)    \n",
    "# have the same x axis for the two plots    \n",
    "for i in range(0, data1['BPDwf'].shape[0]):\n",
    "    ax1.plot(1e9*data1['x'][0,:], 1e3*data1['BPDwf'][i,2,:], label='BPDwf', alpha=0.5, color='C0')\n",
    "ax1.set_xlabel('time (ns)')\n",
    "ax1.set_ylabel('BPD signal (mV)')\n",
    "ax1.grid()\n",
    "im = ax2.imshow(1e3*data1['BPDwf'][:,2,:], aspect='auto', extent=[1e9*data1['x'][0,0], 1e9*data1['x'][0,-1], 0, phase_time_delay[-1]-phase_time_delay[0]], origin='lower', cmap='YlGnBu')\n",
    "ax2.set_xlabel('time (ns)')\n",
    "ax2.set_ylabel('delay (ps)')\n",
    "ax1.text(0.95, 0.905,'(a)', ha='center', va='center', transform=ax1.transAxes)\n",
    "ax2.text(0.95, 0.905,'(b)', ha='center', va='center', transform=ax2.transAxes)\n",
    "\n",
    "# add color bar horizontalky within ax2\n",
    "# scale the color bar to fit within ax2 reduce the size of the color bar\n",
    "# add a colorbar to ax2 within the plot and make sure its scale is within 0.3 of the ax2 width\n",
    "cbar_ax = ax2.inset_axes([0.1, 0.4, 0.3, 0.1])  # [x0, y0, width, height]  \n",
    "cbar = plt.colorbar(im, cax=cbar_ax, orientation='horizontal')\n",
    "cbar.set_label('BPD signal (mV)')\n",
    "\n",
    "\n",
    "#cbar = plt.colorbar(im, ax=ax2)\n",
    "#cbar.set_label('BPD signal (mV)')\n",
    "# share the same x axis\n",
    "plt.tight_layout()\n",
    "plt.savefig('BPDwf_combined.png', dpi=300, bbox_inches='tight', transparent  ='true')"
   ]
  },
