   "id": "2012fcc3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(601, 4, 5000)\n",
      "(1, 5000)\n",
      "[ 56.35874227 105.97624052   0.12558783]\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "<matplotlib.legend.Legend at 0x7fbd99b45bd0>"
      ]
